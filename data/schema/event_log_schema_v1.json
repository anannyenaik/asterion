{
  "schema_name": "asterion.event_log",
  "schema_version": 1,
  "status": "stable for checked-in fixtures",
  "migration_documentation": "docs/event_log_schema.md",
  "binary": {
    "magic_ascii": "ASTITCH1",
    "endianness": "little",
    "header_size_bytes": 16,
    "record_size_bytes": 58,
    "header_layout": [
      {
        "name": "magic",
        "offset": 0,
        "width_bytes": 8,
        "encoding": "ascii",
        "value": "ASTITCH1"
      },
      {
        "name": "schema_version",
        "offset": 8,
        "width_bytes": 2,
        "type": "uint16",
        "value": 1
      },
      {
        "name": "header_size_bytes",
        "offset": 10,
        "width_bytes": 2,
        "type": "uint16",
        "value": 16
      },
      {
        "name": "record_size_bytes",
        "offset": 12,
        "width_bytes": 2,
        "type": "uint16",
        "value": 58
      },
      {
        "name": "reserved",
        "offset": 14,
        "width_bytes": 2,
        "type": "uint16",
        "value": 0
      }
    ],
    "record_layout": [
      {
        "name": "timestamp_ns",
        "offset": 0,
        "width_bytes": 8,
        "type": "int64",
        "signed": true
      },
      {
        "name": "sequence_number",
        "offset": 8,
        "width_bytes": 8,
        "type": "uint64",
        "signed": false
      },
      {
        "name": "symbol_id",
        "offset": 16,
        "width_bytes": 4,
        "type": "uint32",
        "signed": false
      },
      {
        "name": "event_type",
        "offset": 20,
        "width_bytes": 1,
        "type": "uint8",
        "enum": "MarketEventType",
        "signed": false
      },
      {
        "name": "side",
        "offset": 21,
        "width_bytes": 1,
        "type": "uint8",
        "enum": "Side",
        "signed": false
      },
      {
        "name": "flags",
        "offset": 22,
        "width_bytes": 4,
        "type": "uint32",
        "signed": false
      },
      {
        "name": "price_ticks",
        "offset": 26,
        "width_bytes": 8,
        "type": "int64",
        "signed": true
      },
      {
        "name": "quantity",
        "offset": 34,
        "width_bytes": 8,
        "type": "int64",
        "signed": true
      },
      {
        "name": "order_id",
        "offset": 42,
        "width_bytes": 8,
        "type": "uint64",
        "signed": false
      },
      {
        "name": "trade_id",
        "offset": 50,
        "width_bytes": 8,
        "type": "uint64",
        "signed": false
      }
    ],
    "flags": {
      "snapshot_begin": 1,
      "snapshot_end": 2,
      "other_bits": "preserved in the event checksum; no v1 replay semantics outside Snapshot framing"
    },
    "snapshot_marker_conventions": {
      "begin_flag": 1,
      "end_flag": 2,
      "begin_resets_book": true,
      "payload_order_id_zero": "pure marker with no resting order payload",
      "payload_order_id_nonzero": "Snapshot record reinstates one resting order"
    }
  },
  "csv": {
    "header": "timestamp_ns,sequence_number,symbol_id,event_type,side,price_ticks,quantity,order_id,trade_id,flags",
    "columns": [
      "timestamp_ns",
      "sequence_number",
      "symbol_id",
      "event_type",
      "side",
      "price_ticks",
      "quantity",
      "order_id",
      "trade_id",
      "flags"
    ],
    "required_columns": [
      "timestamp_ns",
      "sequence_number",
      "symbol_id",
      "event_type",
      "side",
      "price_ticks",
      "quantity",
      "order_id",
      "trade_id",
      "flags"
    ],
    "numeric_parsing": "base-10 integral fields parsed without trailing characters",
    "canonical_event_type_spelling": [
      "Add",
      "Cancel",
      "Replace",
      "Execute",
      "Trade",
      "Snapshot",
      "Heartbeat"
    ]
  },
  "enums": {
    "MarketEventType": {
      "Add": 1,
      "Cancel": 2,
      "Replace": 3,
      "Execute": 4,
      "Trade": 5,
      "Snapshot": 6,
      "Heartbeat": 7
    },
    "Side": {
      "None": 0,
      "Buy": 1,
      "Sell": 2
    }
  },
  "fixtures": [
    {
      "path": "data/samples/sample_replay.csv",
      "format": "csv",
      "event_count": 5,
      "event_checksum": 12935086771656564198
    },
    {
      "path": "data/samples/sample_replay.bin",
      "format": "binary",
      "event_count": 5,
      "event_checksum": 12935086771656564198
    },
    {
      "path": "data/samples/sample_hot_path_replay.csv",
      "format": "csv",
      "event_count": 12,
      "event_checksum": 8204296528451087376
    },
    {
      "path": "data/samples/sample_hot_path_replay.bin",
      "format": "binary",
      "event_count": 12,
      "event_checksum": 8204296528451087376
    },
    {
      "path": "data/samples/binance_depth_sample.normalised.csv",
      "format": "csv",
      "event_count": 11,
      "event_checksum": 9673906315134520083
    },
    {
      "path": "data/samples/binance_depth_sample.normalised.bin",
      "format": "binary",
      "event_count": 11,
      "event_checksum": 9673906315134520083
    }
  ]
}
